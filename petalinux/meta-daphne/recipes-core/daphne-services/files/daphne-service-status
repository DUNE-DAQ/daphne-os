#!/usr/bin/env python3
"""Publish a configuration summary, not a hardware-health assertion."""

from __future__ import annotations

import argparse
import os
import re
import subprocess
import sys
from collections.abc import Mapping


def status_text(state: str, env: Mapping[str, str]) -> str:
    if state == "stop":
        # Later stop hooks (including quiesce) can still fail. Do not freeze a
        # premature 'success' here; systemd owns the final unit Result.
        return "Server stopped | check Result and journalctl -u daphne for shutdown details"

    mode = env.get("GATEWARE_MODE", "unknown")
    if mode not in ("self-trigger", "full-stream"):
        mode = "unknown"
    major = env.get("IDENTITY_ABI_MAJOR", "")
    minor = env.get("IDENTITY_ABI_MINOR", "")
    abi = f"{major}.{minor}" if all(
        re.fullmatch(r"[0-9]{1,5}", value) for value in (major, minor)
    ) else "unknown"
    build = env.get("IDENTITY_BUILD_ID", "")
    if re.fullmatch(r"0[xX][0-9a-fA-F]{1,8}|[0-9]{1,10}", build):
        number = int(build, 16 if build.lower().startswith("0x") else 10)
        build = f"0x{number:08X}" if number <= 0xFFFFFFFF else "unknown"
    else:
        build = "unknown"
    # A configured timing profile is not evidence of timing lock or readiness.
    timing = "configured (not lock status)" if env.get("TIMING_PROFILE", "").strip() else "NOT CONFIGURED"
    return (
        f"Config: {mode} | ABI {abi} | build {build} | "
        f"timing: {timing} | sensor health: see journal"
    )


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("state", choices=("start", "stop"), nargs="?", default="start")
    parser.add_argument("--print", action="store_true", dest="print_only")
    args = parser.parse_args()
    summary = status_text(args.state, os.environ)
    if args.print_only:
        print(summary)
        return 0
    try:
        # Keep this Exec* process alive until the notification is acknowledged.
        # Do not send READY= or MAINPID=: lifecycle ownership stays with systemd.
        subprocess.run(["systemd-notify", "--status=" + summary], check=True, timeout=3)
    except (OSError, subprocess.SubprocessError) as exc:
        print(f"Status display unavailable (server lifecycle unchanged): {exc}", file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
