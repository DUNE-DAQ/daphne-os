# create the folder where the file will be located
file mkdir ../ip_repo/axilite_ram_ip/xgui

# set the file path
set ram_xgui_file_path "../ip_repo/axilite_ram_ip/xgui/outspy64_axilite_v1_0.tcl"

# create/open the file 
set ramfileId [open $ram_xgui_file_path "w"]

# write the gui content
puts $ramfileId {# Definitional proc to organize widgets for parameters.
proc init_gui { IPINST } {
  ipgui::add_param $IPINST -name "Component_Name"
  #Adding Page
  set Page_0 [ipgui::add_page $IPINST -name "Page 0"]
  ipgui::add_param $IPINST -name "C_S_AXI_DATA_WIDTH" -parent ${Page_0}
  ipgui::add_param $IPINST -name "C_S_AXI_ADDR_WIDTH" -parent ${Page_0}


}

