#!/usr/bin/env python3
"""Back up, erase and re-enumerate the sole named FT4232H adapter."""
import datetime
from pathlib import Path
import re
import subprocess
import sys
from station_config import load_station

asset = sys.argv[1]
if not re.fullmatch(r'DAPHNE-[0-9]{3}', asset):
    raise SystemExit('Asset must be DAPHNE-NNN')
root = Path(__file__).resolve().parents[1]
evidence = root / 'evidence' / asset / 'ftdi'
evidence.mkdir(parents=True, exist_ok=True)
tool = str(Path(load_station(root)['vivado_root']) / 'bin/program_ftdi')
output = subprocess.check_output([tool, '-list'], text=True)
rows = [line.split() for line in output.splitlines() if len(line.split()) >= 4
        and re.fullmatch(r'0x[0-9a-fA-F]+', line.split()[1]) and line.split()[2] == 'FT4232H']
if len(rows) != 1 or rows[0][3] != asset.replace('-', ''):
    raise SystemExit('Could not uniquely match the named FT4232H; no FTDI erase issued')
location = rows[0][1]
timestamp = datetime.datetime.now(datetime.timezone.utc).strftime('%Y%m%dT%H%M%SZ')
with (evidence / ('erase-' + timestamp + '.log')).open('w') as log:
    for args in (['-read', '-location', location, '-fileout', str(evidence / ('before-erase-' + timestamp + '.cfg'))],
                 ['-erase', '-location', location]):
        subprocess.run([tool, *args], stdin=subprocess.DEVNULL, stdout=log, stderr=subprocess.STDOUT, check=True)
subprocess.run([sys.executable, str(root / 'bin/reconnect-ftdi'), asset, '--blank'], check=True)
print('FTDI erased and factory default identity verified; redeployment will restore its named identity.')
