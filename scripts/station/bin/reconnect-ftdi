#!/usr/bin/env python3
"""Attempt a logical USB reconnect; verify the new identity before succeeding."""
import argparse
import errno
import fcntl
from pathlib import Path
import re
import subprocess
import time

p = argparse.ArgumentParser(description=__doc__)
p.add_argument('asset')
a = p.parse_args()
if not re.fullmatch(r'DAPHNE-[0-9]{3}', a.asset):
    p.error('Asset must be DAPHNE-NNN')
devices = [d for d in Path('/sys/bus/usb/devices').iterdir()
           if (d / 'idVendor').is_file() and (d / 'idVendor').read_text().strip() == '0403'
           and (d / 'idProduct').read_text().strip() == '6011']
if len(devices) != 1:
    raise SystemExit('Connect exactly one FT4232H adapter')
device = devices[0]
(device / 'authorized').write_text('0')
time.sleep(1)
(device / 'authorized').write_text('1')
subprocess.run(['udevadm', 'settle'], check=True)
serial_file = device / 'serial'
serial = serial_file.read_text().strip() if serial_file.is_file() else ''
if serial != a.asset.replace('-', ''):
    bus = int((device / 'busnum').read_text())
    number = int((device / 'devnum').read_text())
    try:
        with open(f'/dev/bus/usb/{bus:03d}/{number:03d}', 'wb') as handle:
            fcntl.ioctl(handle, 0x5514, 0)  # USBDEVFS_RESET
    except OSError as exc:
        # Changed descriptors cause Linux to remove the old device and enumerate
        # a new one. ENODEV on the old fd can therefore indicate successful reset.
        if exc.errno != errno.ENODEV:
            raise
deadline = time.monotonic() + 10
while time.monotonic() < deadline:
    subprocess.run(['udevadm', 'settle'], check=True)
    links = list(Path('/dev/serial/by-id').glob('*' + a.asset.replace('-', '') + '*if01-port0'))
    serial_file = device / 'serial'
    serial = serial_file.read_text().strip() if serial_file.is_file() else ''
    if serial == a.asset.replace('-', '') and len(links) == 1:
        break
    time.sleep(.2)
else:
    raise SystemExit('New FTDI identity not visible; physical USB reconnect is required')
print(f'FTDI verified: {serial}; UART={links[0].resolve()}')
