#!/usr/bin/env python3
"""Start a fresh Bash and compare its history with the operator manual."""
import datetime
import ipaddress
import os
from pathlib import Path
import re
import subprocess

import sys
arguments = sys.argv[1:]
clean = '--clean' in arguments
arguments = [arg for arg in arguments if arg != '--clean']
if not arguments:
    asset, address, revision = 'DAPHNE-006', '192.168.0.206', 'V2'
elif len(arguments) == 3:
    asset, address, revision = arguments
else:
    raise SystemExit('Usage: start-manual-session [DAPHNE-NNN IPv4 V2|V3] [--clean]')
if not re.fullmatch(r'DAPHNE-[0-9]{3}', asset) or revision not in ('V2', 'V3'):
    raise SystemExit('Invalid asset or carrier revision')
ipaddress.IPv4Address(address)
root = Path(__file__).resolve().parents[1]
manual = (root / 'README.md').read_text()
mode = 'clean' if clean else 'normal'
match = re.search(r'<!-- manual-history:' + mode + r':start -->\s*```bash\n(.*?)```\s*<!-- manual-history:' + mode + r':end -->', manual, re.S)
if not match:
    raise SystemExit('Manual command block is missing')
expected = match.group(1)
directory = Path.home() / '.daphne-manual-history'
directory.mkdir(mode=0o700, exist_ok=True)
timestamp = datetime.datetime.now(datetime.timezone.utc).strftime('%Y%m%dT%H%M%S.%fZ')
history = directory / (timestamp + '.bash_history')
history.touch(mode=0o600, exist_ok=False)
env = os.environ.copy()
env.update(DAPHNE_ASSET=asset, DAPHNE_IP=address, DAPHNE_REVISION=revision)
for name in ('PROMPT_COMMAND', 'HISTTIMEFORMAT', 'BASH_ENV', 'ENV'):
    env.pop(name, None)
env.update(HISTFILE=str(history), HISTSIZE='1000', HISTFILESIZE='1000',
           HISTCONTROL='', HISTIGNORE='', PS1='DAPHNE-manual$ ')
print(f'Board: {asset}, {address}, {revision}\nFresh manual history: {history}\nType only these commands:\n{expected}', flush=True)
subprocess.run(['/bin/bash', '--noprofile', '--norc', '-i'], env=env)
actual = history.read_text()
if actual != expected:
    raise SystemExit(f'HISTORY DOES NOT MATCH THE MANUAL: {history}')
print(f'HISTORY MATCHES THE MANUAL exactly: {history}')
